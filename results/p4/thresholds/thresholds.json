        "basis": "derived"
      },
      "params_budget": {
        "value": 20480,
        "formula": "params_max = memory_budget_bytes / bytes_per_param",
        "memory_kb": 80,
        "dtype_bytes": 4,
        "basis": "operational",
        "requires": "必须写明目标设备的内存预算来源"
      },
      "requires_seed_completeness": true,
      "gates": [
        {
          "metric": "mean_f1",
          "pass_op": ">=",
          "pass_value": 0.431972,
          "falsify_op": "<",
          "falsify_value": 0.431972,
          "on_fail": "falsified",
          "else": "falsified"
        },
        {
          "metric": "deploy_params",
          "pass_op": "<=",
          "pass_value": 20480,
          "falsify_op": ">",
          "falsify_value": 20480,
          "on_fail": "falsified",
          "else": "falsified"
        }
